<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Seekr.Core\Seekr.Core.csproj" />
    <ProjectReference Include="..\Seekr.Indexer\Seekr.Indexer.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3537.50" />
    <PackageReference Include="WPF-UI" Version="4.3.0" />
  </ItemGroup>

  <ItemGroup><Resource Include="Assets/Wallpapers/*.png" /><Resource Include="Assets/Icons/*.png" /><Resource Include="Assets/Fonts/*" /><Resource Include="Assets/Brand/Seekr-square.ico" /></ItemGroup>
  <ItemGroup><InternalsVisibleTo Include="Seekr.App.Tests" /></ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets/Brand/Seekr-square.ico</ApplicationIcon>
  </PropertyGroup>

</Project>

