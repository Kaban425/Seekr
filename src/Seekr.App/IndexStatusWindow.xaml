<ui:FluentWindow x:Class="Seekr.App.IndexStatusWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
 UseLayoutRounding="True" SnapsToDevicePixels="True" Foreground="{DynamicResource Seekr.TextPrimary}" Background="{DynamicResource Seekr.Canvas}" FontFamily="{DynamicResource Seekr.TextFont}" FontSize="13" Title="Состояние поиска" Width="860" Height="560" MinWidth="640" MinHeight="400" WindowStartupLocation="CenterOwner">
 <DockPanel Margin="24" LayoutTransform="{DynamicResource Seekr.ContentScale}">
  <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12"><Button x:Name="CloseWindowButton" DockPanel.Dock="Right" Content="Закрыть" Click="Close_Click" MinWidth="90"/><TextBlock Text="Поиск по дискам" FontSize="24" FontWeight="SemiBold" TextWrapping="Wrap"/></DockPanel>
  <TextBlock x:Name="StateText" DockPanel.Dock="Top" Text="{Binding Status}" TextWrapping="Wrap" Margin="0,0,0,12"/>
  <TextBlock x:Name="ServiceText" DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,16"/>
  <StackPanel DockPanel.Dock="Bottom" Margin="0,16,0,0">
   <TextBlock Text="Служба ускоряет поиск на NTFS. Просмотр папок работает без неё. При установке Windows один раз запросит права администратора." TextWrapping="Wrap" Opacity="0.75" Margin="0,0,0,12"/>
   <WrapPanel><Button x:Name="InstallButton" Content="Установить / обновить службу" Click="Install_Click" Margin="0,0,12,8"/>
    <Button x:Name="RefreshButton" Content="Обновить индекс" Click="Refresh_Click" Margin="0,0,12,8"/><Button x:Name="UninstallButton" Content="Удалить службу" Click="Uninstall_Click" Margin="0,0,12,8"/></WrapPanel>
  </StackPanel>
  <DataGrid ItemsSource="{Binding Volumes}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" AutomationProperties.Name="Состояние индексации дисков">
   <DataGrid.Columns><DataGridTextColumn Header="Диск" Binding="{Binding Path}" Width="70"/>
    <DataGridTextColumn Header="Режим" Binding="{Binding Mode}" Width="170"/>
    <DataGridTextColumn Header="Элементов" Binding="{Binding Entries}" Width="100"/>
    <DataGridTextColumn Header="Ограничения / причина" Binding="{Binding Error}" Width="*"/>
   </DataGrid.Columns>
  </DataGrid>
 </DockPanel>
</ui:FluentWindow>
