<ui:FluentWindow x:Class="Seekr.App.BatchRenameWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
 Title="Пакетное переименование" Width="860" Height="640" MinWidth="560" MinHeight="400" WindowStartupLocation="CenterOwner" Background="{DynamicResource Seekr.Canvas}" Foreground="{DynamicResource Seekr.TextPrimary}" FontFamily="{DynamicResource Seekr.TextFont}">
 <Grid Background="{DynamicResource Seekr.Canvas}" Margin="20" LayoutTransform="{DynamicResource Seekr.ContentScale}">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <ScrollViewer MaxHeight="240" VerticalScrollBarVisibility="Auto"><StackPanel>
   <TextBlock Text="Пакетное переименование" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,12"/>
   <StackPanel IsEnabled="{Binding CanEdit}">
    <TextBlock Text="Шаблон имени"/><ui:TextBox Style="{StaticResource Seekr.FormInput}" Text="{Binding Pattern, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Шаблон имени"/>
    <WrapPanel Margin="0,8"><StackPanel Width="170" Margin="0,0,8,0"><TextBlock Text="Найти в имени"/><ui:TextBox Style="{StaticResource Seekr.FormInput}" Text="{Binding Find, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Найти в имени"/></StackPanel><StackPanel Width="170" Margin="0,0,8,0"><TextBlock Text="Заменить на"/><ui:TextBox Style="{StaticResource Seekr.FormInput}" Text="{Binding Replace, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Заменить на"/></StackPanel><StackPanel Width="90"><TextBlock Text="Номер от"/><ui:TextBox Style="{StaticResource Seekr.FormInput}" Text="{Binding Start, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Начальный номер"/></StackPanel></WrapPanel>
    <CheckBox Content="Сохранять расширение файла" IsChecked="{Binding PreserveExtension}" Margin="0,0,0,8"/>
   </StackPanel>
   <Button Content="Предпросмотр" Command="{Binding PreviewCommand}" HorizontalAlignment="Left" Margin="0,0,0,12"/>
  </StackPanel></ScrollViewer>
  <ListView Grid.Row="1" ItemsSource="{Binding Rows}" Background="{DynamicResource Seekr.Surface}" Foreground="{DynamicResource Seekr.TextPrimary}" AutomationProperties.Name="Предпросмотр новых имён" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
   <ListView.Resources><Style TargetType="GridViewColumnHeader"><Setter Property="Background" Value="{DynamicResource Seekr.Surface}"/><Setter Property="Foreground" Value="{DynamicResource Seekr.TextSecondary}"/><Setter Property="Padding" Value="8"/></Style></ListView.Resources>
   <ListView.View><GridView><GridViewColumn Header="Старое имя" DisplayMemberBinding="{Binding OldName}" Width="220"/><GridViewColumn Header="Новое имя" DisplayMemberBinding="{Binding NewName}" Width="220"/><GridViewColumn Header="Проверка" DisplayMemberBinding="{Binding Status}" Width="250"/></GridView></ListView.View>
  </ListView>
  <StackPanel Grid.Row="2" Margin="0,12,0,0"><TextBlock Text="{Binding Status}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" MaxHeight="90"/><WrapPanel Margin="0,12,0,0"><Button Content="Применить" Command="{Binding ApplyCommand}" Margin="0,0,8,0"/><Button Content="Вернуть исходные имена" Command="{Binding UndoCommand}" Margin="0,0,8,0"/><Button Content="Отменить задание" Command="{Binding CancelCommand}" IsEnabled="{Binding IsBusy}"/></WrapPanel></StackPanel>
 </Grid>
</ui:FluentWindow>
