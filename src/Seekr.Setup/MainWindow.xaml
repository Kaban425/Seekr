<Window x:Class="Seekr.Setup.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
 Title="Установка Seekr" Width="820" Height="590" MinWidth="740" MinHeight="560" ResizeMode="NoResize" WindowStyle="None" Background="#D915202E" Foreground="#F3F7FC" FontFamily="Segoe UI" FontSize="14" WindowStartupLocation="CenterScreen" Icon="Brand.ico" UseLayoutRounding="True">
 <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="52" GlassFrameThickness="-1" CornerRadius="14" ResizeBorderThickness="0"/></shell:WindowChrome.WindowChrome>
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="52"/><RowDefinition Height="*"/><RowDefinition Height="78"/></Grid.RowDefinitions>
  <Grid.ColumnDefinitions><ColumnDefinition Width="250"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Grid.RowSpan="3" Background="#4D28435C"><Grid Margin="28,100,28,28"><StackPanel VerticalAlignment="Center"><Image Source="Brand.png" Width="116" Height="116" HorizontalAlignment="Left" Margin="-8,0,0,24"/><TextBlock Text="Seekr" FontSize="38" FontWeight="SemiBold"/><TextBlock Text="Твои файлы.&#10;Твой стиль." FontSize="22" Foreground="#B8D7EE" Margin="0,12,0,28"/><Border Height="2" Background="#779EE2FA" Width="64" HorizontalAlignment="Left"/><TextBlock Text="Быстро находить.&#10;Удобно работать.&#10;Настраивать под себя." Foreground="{StaticResource Muted}" Margin="0,24,0,0" LineHeight="25"/></StackPanel><TextBlock x:Name="VersionText" VerticalAlignment="Bottom" Foreground="{StaticResource Muted}" FontSize="12"/></Grid></Border>
  <TextBlock Grid.Column="1" Text="УСТАНОВКА" Foreground="{StaticResource Muted}" FontSize="11" Margin="32,21,0,0"/>
  <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,8,6" shell:WindowChrome.IsHitTestVisibleInChrome="True"><Button Content="−" Width="40" Padding="0" Background="Transparent" BorderThickness="0" Click="Minimize_Click" AutomationProperties.Name="Свернуть"/><Button Content="×" Width="40" Padding="0" Background="Transparent" BorderThickness="0" Click="Close_Click" AutomationProperties.Name="Закрыть установщик"/></StackPanel>
  <ScrollViewer Grid.Row="1" Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="32,30,32,0">
   <TextBlock x:Name="Heading" Text="Начнём с удобства" FontSize="28" FontWeight="SemiBold"/>
   <TextBlock x:Name="Description" Text="Seekr будет готов к работе через несколько минут." Foreground="{StaticResource Muted}" Margin="0,12,0,24" LineHeight="22"/>
   <StackPanel x:Name="OptionsPanel"><TextBlock Text="Папка установки" Foreground="#D2DDE9" Margin="0,0,0,8"/>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="DirectoryInput" AutomationProperties.Name="Папка установки"/><Button x:Name="BrowseButton" Grid.Column="1" Content="…" Width="44" Margin="8,0,0,0" Padding="0" Click="Browse_Click" AutomationProperties.Name="Выбрать папку установки"/></Grid>
    <CheckBox x:Name="DesktopShortcut" Content="Ярлык на рабочем столе" IsChecked="True" Margin="0,18,0,8"/>
    <TextBlock Text="Установка для текущего пользователя. Подключение к интернету не требуется." Foreground="{StaticResource Muted}" FontSize="12" Margin="0,10,0,0"/>
   </StackPanel>
   <StackPanel x:Name="ProgressPanel" Visibility="Collapsed" Margin="0,8,0,0"><ProgressBar x:Name="ProgressBar" Height="5" Maximum="100" Foreground="#8ADAFE" Background="#31465C" IsIndeterminate="True"/><TextBlock x:Name="ProgressText" Text="Подготовка…" Foreground="{StaticResource Muted}" Margin="0,16,0,0"/></StackPanel>
   <TextBlock x:Name="StatusText" Foreground="#FFC9AD" Margin="0,18,0,0"/>
   <Button x:Name="LogButton" Content="Открыть журнал установки" HorizontalAlignment="Left" Visibility="Collapsed" Click="Log_Click" Margin="0,12,0,0"/>
  </StackPanel></ScrollViewer>
  <Border Grid.Column="1" Grid.Row="2" BorderBrush="#25496C8C" BorderThickness="0,1,0,0" Padding="32,16"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Button x:Name="LicenseButton" Content="Лицензия MIT" HorizontalAlignment="Left" Background="Transparent" BorderThickness="0" Padding="0" Click="License_Click" Foreground="{StaticResource Muted}"/><Button x:Name="PrimaryButton" Grid.Column="1" Content="Установить Seekr  →" Background="#8ADAFE" Foreground="#10202E" BorderBrush="#B0E8FF" FontWeight="SemiBold" Padding="22,10" Click="Primary_Click"/></Grid></Border>
 </Grid>
</Window>
